# TEMPLATE ONLY — this file is committed to git, so keep it free of real secrets.
# For local runs, copy this to `backend/.env` (gitignored) and fill it in there.
# For production, set these in Railway → your service → Variables.

# MongoDB Atlas → Connect → Drivers (replace <password>, keep the /watchparty db).
MONGODB_URI=mongodb+srv://user:<password>@cluster0.xxxxx.mongodb.net/watchparty

# Optional. DB_NAME defaults to watchparty.
DB_NAME=watchparty

# GOOGLE_CLIENT_ID: leave UNSET to accept tokens from both the Web client
# (launchWebAuthFlow / Brave) and the Chrome-extension client. If you set it, it
# OVERRIDES that default, so include every client id you use, comma-separated:
# GOOGLE_CLIENT_ID=570897047586-obh6j98a93u8fkbftdlvl49eahvp61tn.apps.googleusercontent.com,570897047586-b71eq79nrrrln298h2kjctpi27o3se48.apps.googleusercontent.com

# Railway sets PORT automatically — do NOT set it yourself.
