# Copy these into Railway → your service → Variables.
# Do NOT put real secrets in THIS file — it is committed to git. Use Railway's
# Variables, or a local .env (which is gitignored).

# From MongoDB Atlas → Connect → Drivers (replace <password> and add the db name).
# e.g. mongodb+srv://user:<password>@cluster0.xxxxx.mongodb.net/watchparty?retryWrites=true&w=majority
MONGODB_URI=

# Optional (defaults shown)
DB_NAME=watchparty
GOOGLE_CLIENT_ID=570897047586-b71eq79nrrrln298h2kjctpi27o3se48.apps.googleusercontent.com

# Railway sets PORT automatically — do NOT set it yourself.
